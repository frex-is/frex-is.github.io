---
import BaseLayout from "@layouts/BaseLayout.astro"
import Header from "@components/navigation/Header.astro"
import { Icon } from 'astro-icon/components'
import { getCollection } from "astro:content"
import ProfileCard from "@components/home/ProfileCard.astro"
import StatsGrid from "@components/home/StatsGrid.astro"
import TechBadges from "@components/home/TechBadges.astro"
import LatestArticles from "@components/home/LatestArticles.astro"

const posts = await getCollection("blog")
const latestPosts = posts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)

const socialLinks = [
  { label: "GitHub", href: "https://github.com/frex-is", icon: "lucide:github" },
  { label: "LinkedIn", href: "#", icon: "lucide:linkedin" },
  { label: "Twitter", href: "#", icon: "lucide:twitter" },
]

const technologies = ["Python", "Kotlin", "Spark", "Iceberg", "React", "Docker", "Linux"]

const stats = [
  { value: "+3", label: "ans d'expérience" },
  { value: String(posts.length), label: "articles publiés" },
  { value: "8", label: "projets perso" },
  { value: "Open Source", label: "passionné" },
]
---

<BaseLayout title="Accueil">
  <div class="fixed inset-0 pointer-events-none z-0 opacity-[0.02]"
    style="background-image:
      linear-gradient(rgba(255,255,255,1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px);
      background-size: 64px 64px;"
  />

  <Header />

  <div class="relative z-10 min-h-[calc(100vh-4rem)] flex items-center py-12 md:py-20">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        <ProfileCard
          initials="MJ"
          name="Jérémy"
          role="Développeur R&D Big Data"
          links={socialLinks}
        />

        <div class="lg:col-span-9">
          <div class="relative">
            <div class="hidden md:block absolute -top-12 -left-6 text-[clamp(6rem,10vw,10rem)] font-black text-text-primary select-none pointer-events-none leading-none opacity-[0.03] tracking-tighter">
              DÉVELOPPEUR
            </div>

            <div class="relative space-y-8 md:space-y-10">
              <div>
                <h1 class="text-[clamp(1.8rem,3.5vw,2.8rem)] font-extrabold tracking-tight text-text-primary leading-tight">
                  Salut, moi c'est <span class="text-accent-cyan">Jérémy</span>
                </h1>
                <p class="text-sm font-semibold text-accent-cyan tracking-wider uppercase mt-2">
                  Développeur R&D Big Data
                </p>
                <p class="text-base text-text-muted italic mt-4 border-l-2 border-accent-cyan/30 pl-4">
                  "J'apprends en construisant, et je construis pour apprendre."
                </p>
                <p class="text-base text-text-secondary leading-relaxed mt-6">
                  Je suis développeur en R&D Big Data, passionné par l'ingénierie logicielle et les systèmes distribués.
                  J'aime autant écrire du code que comprendre ce qui se passe sous le capot d'une technologie.
                </p>
                <p class="text-base text-text-secondary leading-relaxed mt-4">
                  Entre Python, Kotlin et les projets personnels que je développe pour apprendre de nouvelles choses,
                  j'ai créé ce blog pour partager mes expérimentations, mes retours d'expérience et quelques astuces
                  qui pourront, je l'espère, être utiles à d'autres développeurs.
                </p>
              </div>

              <div class="flex flex-wrap gap-4">
                <a
                  href="/blog"
                  class="inline-flex items-center gap-2 px-6 py-3 bg-accent-cyan/10 border border-accent-cyan/30 rounded-card text-sm font-semibold text-accent-cyan no-underline hover:bg-accent-cyan/20 hover:border-accent-cyan/50 hover:scale-[1.02] transition-all duration-200 group shadow-none hover:shadow-[0_0_20px_-5px_rgba(34,211,238,0.3)]"
                >
                  Voir les articles
                  <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
                <a
                  href="#"
                  class="inline-flex items-center gap-2 px-6 py-3 border border-border rounded-card text-sm font-semibold text-text-secondary no-underline hover:border-text-muted hover:text-text-primary transition-all duration-200"
                >
                  <Icon name="lucide:folder-git-2" class="size-[18px]" />
                  Mes projets
                </a>
              </div>

              <StatsGrid stats={stats} />
              <TechBadges technologies={technologies} />

              {latestPosts.length > 0 && (
                <LatestArticles posts={latestPosts} />
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
