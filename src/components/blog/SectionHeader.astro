---
export interface Props {
  sectionId: string
  label: string
}

const { sectionId, label } = Astro.props
---

<div id={sectionId} class="flex items-center gap-4 mb-6">
  <span class="font-mono text-xs font-bold text-accent-cyan px-3 py-1 rounded-pill whitespace-nowrap border bg-surface/80 border-cyan-400/20">{label}</span>
  <span class="flex-1 h-px bg-gradient-to-r from-slate-800 to-transparent" aria-hidden="true"></span>
</div>
