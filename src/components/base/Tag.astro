---
export type TagVariant = 'default' | 'green' | 'red' | 'purple'

export interface TagProps {
  label: string
  variant?: TagVariant
}

const { label, variant = 'default' } = Astro.props

const variantStyles: Record<string, string> = {
  default: 'bg-accent-cyan/8 border-accent-cyan/20 text-accent-cyan',
  green: 'bg-accent-green/8 border-accent-green/20 text-accent-green',
  red: 'bg-accent-red/8 border-accent-red/20 text-accent-red',
  purple: 'bg-accent-purple/8 border-accent-purple/20 text-accent-purple',
}
---

<span
  class="inline-block text-[11px] font-semibold px-3 py-1 rounded-pill border"
  class:list={[variantStyles[variant]]}
>
  {label}
</span>
