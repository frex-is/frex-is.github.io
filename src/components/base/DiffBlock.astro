---
import { Icon } from 'astro-icon/components'

export interface Props {
  code: string
  title?: string
}

const { code, title } = Astro.props

type LineType = 'add' | 'del' | 'hunk' | 'meta' | 'context'

const lines: { text: string; type: LineType }[] = code.trim().split('\n').map(line => {
  if (line.startsWith('++++') || line.startsWith('----')) return { text: line, type: 'meta' }
  if (line.startsWith('+')) return { text: line, type: 'add' }
  if (line.startsWith('-')) return { text: line, type: 'del' }
  if (line.startsWith('@@')) return { text: line, type: 'hunk' }
  if (/^diff --git|^index |^new file|^deleted file|^rename |^similarity |^Binary files/.test(line)) return { text: line, type: 'meta' }
  return { text: line, type: 'context' }
})

const lastNewFile = [...lines].reverse().find(l => l.type === 'meta' && l.text.startsWith('+++'))
const defaultTitle = lastNewFile ? lastNewFile.text.replace(/^\+\+\+\s+/, '').replace(/^b\//, '').replace(/^a\//, '') : 'diff'
const displayTitle = title || defaultTitle

const addCount = lines.filter(l => l.type === 'add' && l.text.startsWith('+')).length
const delCount = lines.filter(l => l.type === 'del' && l.text.startsWith('-')).length

const typeClasses: Record<LineType, string> = {
  add: 'text-accent-green bg-accent-green/[0.08]',
  del: 'text-accent-red bg-accent-red/[0.08]',
  hunk: 'text-accent-cyan bg-accent-cyan/[0.06]',
  meta: 'text-text-subtle',
  context: 'text-text-muted',
}
---

<div class="group rounded-block border border-border bg-surface-card overflow-hidden my-6">
  <div class="flex items-center justify-between gap-3 px-4 py-[10px] border-b border-border bg-surface/80">
    <div class="flex items-center gap-2.5 min-w-0">
      <Icon name="lucide:git-commit-horizontal" class="shrink-0 size-[15px] text-accent-purple" />
      <span class="font-mono text-[13px] text-text-subtle truncate">{displayTitle}</span>
      <span class="font-mono text-[12px] px-2 py-0.5 rounded-pill border border-accent-green/20 text-accent-green whitespace-nowrap">+{addCount}</span>
      <span class="font-mono text-[12px] px-2 py-0.5 rounded-pill border border-accent-red/20 text-accent-red whitespace-nowrap">−{delCount}</span>
    </div>
    <button class="copy-btn opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1.5 text-text-subtle hover:text-text-secondary text-[13px] shrink-0" data-code={code}>
      <Icon name="lucide:copy" class="size-[14px]" />
      Copy
    </button>
  </div>

  <div class="overflow-x-auto py-2">
    <pre class="!bg-transparent !p-0 leading-[1.7] text-[13px]">
      <code>
        {lines.map((line, i) => (
          <div class:list={['flex gap-3 px-4 whitespace-pre', typeClasses[line.type]]}>
            <span class="select-none shrink-0 w-8 text-right text-text-subtle/50">{i + 1}</span>
            <span>{line.text}</span>
          </div>
        ))}
      </code>
    </pre>
  </div>
</div>

<script>
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.code)
      const original = btn.innerHTML
      btn.innerHTML = 'Copied!'
      setTimeout(() => btn.innerHTML = original, 2000)
    })
  })
</script>