---
export interface Props {
  accent: keyof typeof accentColors;
  bold?: boolean;
}

const accentColors = {
  cyan: '#22d3ee',
  green: '#4ade80',
  red: '#f87171',
  yellow: '#fbbf24',
  purple: '#818cf8',
}

const { accent, bold } = Astro.props as Props;
const color = accentColors[accent];
const fontWeight = bold ? '700' : 'inherit';
---

{color ? (
  <span style={{ color, fontWeight }}><slot /></span>
) : (
  <span style={{ fontWeight }}><slot /></span>
)}