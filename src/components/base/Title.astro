---
export interface Props {
  size?: 1 | 2 | 3
}

const { size = 2 } = Astro.props as Props

const styles: Record<number, string> = {
  1: 'text-[clamp(2rem,4vw,2.5rem)] font-extrabold tracking-tight',
  2: 'text-[clamp(1.5rem,3vw,2rem)] font-extrabold tracking-tight',
  3: 'text-[clamp(1.125rem,2vw,1.35rem)] font-bold tracking-tight',
}
---

<div class=`text-text-primary mb-4 ${styles[size]}`>
  <slot />
</div>
